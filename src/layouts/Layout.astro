---
import '../styles/global.css'
interface Props {
   title: string;
   description?: string; 
}
const {title, description = "Small business service site"} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <meta name="description" content={description} />
    </head>
    <body class="bg-slate-200 text-slate-900 antialiased">
        <slot />

        <!-- Script to catch password reset tokens and send you to /admin -->
        <script is:inline>
            (function (){
                const hash = window.location.hash;
                if(hash && (hash.includes("invite_token") || hash.includes("recovery_token") || hash.includes("confirmation_token"))) {
                    window.location.href = "/admin/" + hash;
                }
            })();
        </script>
    </body>
</html>