---
interface Props {
   title: string;
   description?: string; 
}
const {title, description = "Small business service site"} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <meta name="description" content={description} />
    </head>
    <body class="bg-slate-50 text-slate-900 antialiased">
        <slot />
    </body>
</html>