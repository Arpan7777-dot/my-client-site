---
import '../styles/global.css'
import { Image } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

import Navbar from "../components/TabbedNavbar.astro";
import catIcon from "../components/icons/cat.svg"

interface Props {
   title: string;
   description?: string; 
}
const {title, description = "A website"} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <ClientRouter />
    </head>
    <body class="antialiased font-mono">
        <Navbar brandName="Company Name" phone="+91 98765 43210" />
        
        <slot />

        <!-- Script to catch password reset tokens and send you to /admin -->
        <script is:inline>
            (function (){
                const hash = window.location.hash;
                if(hash && (hash.includes("invite_token") || hash.includes("recovery_token") || hash.includes("confirmation_token"))) {
                    window.location.href = "/admin/" + hash;
                }
            })();
        </script>
    </body>
    <footer class="max-w-7xl mx-auto border-t flex border-ktx-surface0 py-6 pb-20 justify-between">
        <p class="text-xs text-ktx-subtext0 my-2">© {new Date().getFullYear()} Kinetix Dev. All rights reserved.</p>
        <div class="flex items-center">
            <a href="" class="text-xs text-ktx-subtext0 my-2 px-3 border-r-2 border-ktx-surface0">Privacy Policy</a>
            <a href="" class="text-xs text-ktx-subtext0 my-2 px-3 border-r-2 border-ktx-surface0">Terms of Service</a>
            <a href="" class="text-xs text-ktx-subtext0 my-2 px-3">Sitemap</a>
            <div class="overflow-hidden">
                <Image src={catIcon} alt=";)" class="w-5 h-5 -translate-x-10 filter-[invert(1)_drop-shadow(40px_0_0_var(--color-ktx-mauve))]"/>
            </div>
            
        </div>
    </footer>
</html>