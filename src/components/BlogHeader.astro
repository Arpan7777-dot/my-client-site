---
import BlogSearch from './BlogSearch.astro';
interface Props {
    blogHeader: string;
}

const {blogHeader} = Astro.props;
---

<section class="pt-2 pb-4 bg-ktx-mantle">
    <a href="/#" class="text-blue-600 underline italic mx-3">← Go to home page</a>
    <h1 class="py-8 text-center font-extrabold text-4xl sm:text-6xl text-ktx-text">
        {blogHeader}
    </h1>
    <div class="grid grid-cols-3 items-center mb-6 px-4">
        <h2 class="font-bold text-2xl text-ktx-text text-left">Recent Posts</h2>
        <BlogSearch />
        <p class="text-right">filters</p>
    </div>
</section>