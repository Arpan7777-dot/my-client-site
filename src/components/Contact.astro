<section id="contact" class="py-16 bg-slate-100">
    <div class="max-w-xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-6">Get a Free Quote</h2>
        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
            <input type="hidden" name="access_key" value="409203a0-6b0d-4f4f-bfac-5dbf0b50cdef">
            <div>
                <label class="block text-sm font-medium mb-1">Your Name</label>
                <input type="text" name="name" required class="w-full p-3 border rounded-lg" placeholder="John Doe" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Phone Number</label>
                <input type="email" name="email" required class="w-full p-3 border rounded-lg" placeholder="(555) 000-0000" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">How can we help?</label>
                <textarea name="message" rows="4" class="w-full p-3 border rounded-lg" placeholder="Describe the job.."></textarea>
            </div>
            <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 rounded-lg hover:bg-blue-700 transition">Send Message</button>
        </form>
    </div>
</section>