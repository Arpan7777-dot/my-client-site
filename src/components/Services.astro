---
const services = [
  {
    title: "Emergency Repairs",
    desc: "24/7 leak fixing and emergency plumbing services."
  },
  {
    title: "Drain Cleaning",
    desc: "Comprehensive drain cleaning and maintenance services."
  },
  {
    title: "Fixture Installation",
    desc: "Sinks, faucets, and other plumbing fixture installation services."
  },
];
---

<section id="services" class="py-12 bg-white">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class=" py-4 text-3xl font-bold text-center text-slate-900">Our Services</h2>
    <div class="grid md:grid-cols-3 gap-8">
      {services.map(service => (
        <div class="p-6 border border-slate-200 rounded-xl shadow-sm hover:shadow-md transition">
          <h3 class="text-xl text-red-800 font-bold mb-2">{service.title}</h3>
          <p>{service.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>