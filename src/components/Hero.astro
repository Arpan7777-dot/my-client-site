---
interface Props {
    headline: string;
    subheadline: string;
    ctaText: string;
    servicesText: string;
}
const {headline, subheadline, ctaText, servicesText} = Astro.props;
---

<section class="py-20 px-4 text-center max-w-4xl mx-auto">
    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-900">
        {headline}
    </h1>
    <p class="mt-6 text-lg text-slate-600">
        {subheadline}
    </p>
    <div class="mt-8">
        <a href="#contact" class="inline-block bg-blue-600 text-white font-semibold mx-1 my-1 px-6 py-3 rounded-lg shadow hover:bg-blue-700 transition">
            {ctaText}
        </a>
        <a href="#services" class="inline-block bg-blue-600 text-white font-semibold mx-1 my-1 px-6 py-3 rounded-lg shadow hover:bg-blue-700 transition">
            {servicesText}
        </a>
    </div>
</section>