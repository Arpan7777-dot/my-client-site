---
import HighlightText from './HighlightText.astro';
interface Props {
    topping: string;
    headline: string;
    subheadline: string;
    ctaText: string;
    servicesText: string;
}
const {topping, headline, subheadline, ctaText, servicesText} = Astro.props;
---

<section class="relative">
    <div class="mx-auto grid grid-cols-1 lg:grid-cols-2">
        <!-- Left Column: Content -->
        <div class="flex flex-col items-start space-y-4 py-6 px-12">
            <span class="text-ktx-mauve text-xs font-semibold tracking-[0.3em] uppercase">Modern Web Solution for Your Ideas</span>
            <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight whitespace-pre-line">
                <HighlightText text={headline} highlight='Work for You' attr='text-ktx-mauve font-bold'></HighlightText>
            </h1>
            <p class="mt-6 text-lg text-ktx-subtext [word-spacing:0.25rem]">
                {subheadline}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mt-6">
                <a href="#contact" class="inline-block bg-ktx-mauve text-ktx-mantle font-semibold px-6 py-3 rounded-3xl shadow hover:bg-ktx-blue transition">
                    {ctaText}
                </a>
                <a href="#services" class="inline-block text-ktx-text font-semibold px-6 py-3 rounded-3xl border border-ktx-mauve shadow hover:border-ktx-blue transition">
                    {servicesText}
                </a>
            </div>
            <div class="flex flex-row space-x-6 py-2">
                <div class="inline-flex gap-3 text-xs text-center text-ktx-mauve">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4.5">
                        <path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 0 1 .359.852L12.982 9.75h7.268a.75.75 0 0 1 .548 1.262l-10.5 11.25a.75.75 0 0 1-1.272-.71l1.992-7.302H3.75a.75.75 0 0 1-.548-1.262l10.5-11.25a.75.75 0 0 1 .913-.143Z" clip-rule="evenodd" />
                    </svg>
                    <span>Fast delivery</span>
                </div>
                <div class="inline-flex gap-3 text-xs text-center text-ktx-mauve">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-4.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                    </svg>
                    <span>Clean & Maintainable Code</span>
                </div>
                <div class="inline-flex gap-3 text-xs text-center text-ktx-mauve">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-4.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                    </svg>
                    <span>Mobile Friendly</span>
                </div>
            </div>
        </div>
        
        <!-- Right Column: image -->
        <div class="max-h-full relative flex lg:justify-end">
            <img src="/uploads/cover.png" alt="" class="relative object-cover">
            
        </div>
        
    </div>
</section>