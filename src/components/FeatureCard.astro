---
import { Image } from 'astro:assets';
import HighlightText from './HighlightText.astro';
import featureImage from '../components/images/feature.png'
interface Props {
    motto: string;
    heading: string;
    description: string;
}

const {motto, heading, description} = Astro.props;
---


<section class="relative my-25">
    <div class="max-w-7xl mx-4 lg:mx-auto grid grid-cols-1 md:grid-cols-2 bg-ktx-surface0 border border-ktx-surface1 my-4 rounded-xl">
        <!-- Left Column -->
        <div class="flex flex-col items-start space-y-4 px-12 py-6">
            <span class="font-semibold tracking-[0.2em] uppercase text-xs text-ktx-mauve">{motto}</span>
            <h1 class="whitespace-pre-line font-extrabold text-4xl">
                <HighlightText text={heading} highlight='build' attr="text-ktx-maroon"/>         
            </h1>
            <p class="pr-40 text-ktx-subtext0">
                {description}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mt-6">
                <a href="" class="flex justify-center items-center gap-1 rounded-3xl bg-ktx-lavender text-center text-sm text-ktx-mantle py-3 px-6 hover:bg-ktx-blue">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="" class="size-5 fill-ktx-overlay0">
                        <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
                        <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
                    </svg>
                    <p>Start a Project</p>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                </a>
                <a href="" class="flex justify-center items-center gap-1 border-b border-ktx-lavender text-center text-sm text-ktx-text hover:text-ktx-maroon hover:border-ktx-maroon my-2 pt-1 px-4">
                    <p>View My Work</p>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                </a>
            </div>
        </div>
        <!-- Right Column: Image-->
        <div class="relative flex items-center lg:justify-end">
            <Image src={featureImage} alt="" class="hidden h-85 md:block relative object-cover" />
        </div>
    </div>
</section>