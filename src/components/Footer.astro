---
import Social from "./Social.astro";
import QuickLinks from "./QuickLinks.astro";
import FooterServices from "./FooterServices.astro"
import ContactDetails from "./ContactDetails.astro";
---


<section class="relative max-w-7xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 w-full px-6 py-10">
        <Social />
        <QuickLinks />
        <FooterServices />
        <ContactDetails phone="+91 98765 43210" email="palarpan48@gmail.com"/>
    </div>
    <footer class="border-t flex border-ktx-surface0 py-6 pb-20 justify-between">
        <p class="text-xs text-ktx-subtext0 my-2">© {new Date().getFullYear()} Kinetix Dev. All rights reserved.</p>
        <div class="flex items-center">
            <a href="" class="text-xs text-ktx-subtext0 my-2 px-3 border-r-2 border-ktx-surface0">Privacy Policy</a>
            <a href="" class="text-xs text-ktx-subtext0 my-2 px-3 border-r-2 border-ktx-surface0">Terms of Service</a>
            <a href="" class="text-xs text-ktx-subtext0 my-2 px-3">Sitemap</a>
            <div class="overflow-hidden">
                <img src="/src/components/icons/cat.svg" class="w-5 h-5 -translate-x-10 filter-[invert(1)_drop-shadow(40px_0_0_var(--color-ktx-mauve))]"/>
            </div>
            
        </div>
    </footer>
</section>