---
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Footer from "../components/Footer.astro";
import BlogList from "../components/BlogList.astro"
import homePageData from '../content/homepage.json';


interface Props {
    brandName?: string;
    phone?: string;
    companyNameImg?: boolean;
}

const {brandName = "CompanyName", phone = "+91 98765 43210", companyNameImg = true} = Astro.props;

const formattedPhone = phone.replace(/[0-9+]/g, '');
---

<header class="sticky top-0 z-50 w-full bg-ktx-mantle/50 backdrop-blur-lg border-b border-ktx-crust">
    <div class="max-w-7xl mx-auto px-4 h-18 flex items-center justify-between">
        <a href="#" class="flex items-center gap-2 group">
            <img src="/uploads/company-logo.png" class="w-10 h-10 rounded-lg flex items-center justify-center" />
            <div>
                {companyNameImg
                    ? (<img src="/uploads/company-name.png" class="h-9"/>)
                    : <span class="font-bold text-xl sm:text-2xl text-ktx-lavender">{brandName}</span>
                }
                <p class="text-xs text-center text-ktx-mauve"> Build • Design • Grow</p>
            </div>
        </a>

        <!-- Tab Navigation Links (Hidden on small mobile screens) -->
        <nav class="relative hidden md:flex items-center justify-start gap-6 text-sm font-medium">
            <button 
                class="tab-btn z-10 px-4 py-2 text-ktx-lavender font-semibold focus:outilne-none transition"
                data-tab="home"
            >
                Home
            </button>
            <button 
                class="tab-btn z-10 px-4 py-2 text-ktx-subtext0 focus:outilne-none transition"
                data-tab="about"
            >
                About
            </button>
            <button 
                class="tab-btn z-10 px-4 py-2 text-ktx-subtext0 focus:outilne-none transition"
                data-tab="contact"
            >
                Contact
            </button>
            <button 
                class="tab-btn px-4 py-2 text-ktx-subtext0 focus:outilne-none transition"
                data-tab="portfolio"
            >
                Portfolio
            </button>

            <div id="tab-indicator" class="absolute bottom-0 left-0 w-17 h-0.5 bg-ktx-lavender transition-all duration-300 ease-out"></div>
        </nav>

        

        <!-- Phone CTA Button -->
        <a href={`tel:${formattedPhone}`} class="inline-flex items-center gap-2 bg-ktx-lavender text-ktx-mantle font-semibold text-sm px-4 py-2 rounded-3xl shadow-md shadow-blue-600/20 transition duration-200">
            <!-- Call Icon SVG -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" clip-rule="evenodd" />
            </svg>
            <span>Call now</span>
        </a>
    </div>
</header>

<!-- Tab Contents -->
<div id="tab-home" class="tab-panel transition-all duration-300 ease-out opacity-100 translate-y-0 block">
    <main>
        <Hero topping={homePageData.topping} headline={homePageData.heroTitle} subheadline={homePageData.heroSubtitle} ctaText={homePageData.ctaText} servicesText={homePageData.servicesText} />
        <Services />
        <FeatureCard 
            motto="// Let's Work Together" 
            heading={`Got an idea?\nLet's build it.`}
            description="Whether you need a simple website, a full-stack application, or ongoing support - I'm here to help you turn your vision into a clean, fast and modern web solution."
        />
        <Footer />
    </main>
</div>
<div id="tab-about" class="tab-panel transition-all duration-300 ease-out opacity-0 translate-y-2 hidden">
    <p class="p-6 text-center text-bold text-ktx-subtext0">(Section: About Us) Under Construction (:</p>
</div>
<div id="tab-contact" class="tab-panel transition-all duration-300 ease-out opacity-0 translate-y-2 hidden">
    <p class="p-6 text-center text-bold text-ktx-subtext0">(Section: Contact Us) Under Construction (:</p>
</div>
<div id="tab-portfolio" class="tab-panel transition-all duration-300 ease-out opacity-0 translate-y-2 hidden">
    <BlogList />
</div>

<script>
    // @ts-ignore
    import { setupIndicatorTabs } from '../scripts/tabs';

    function init() {
        setupIndicatorTabs();
    }

    // Execute once DOM is fully ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    // Support View Transitions
    document.addEventListener('astro:after-swap', init);
</script>


