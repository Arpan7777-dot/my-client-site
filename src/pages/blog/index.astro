---
import { getCollection } from "astro:content";
import BlogHeader from "../../components/BlogHeader.astro"
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection('blog');
---

<Layout title="Blog">
    <BlogHeader blogHeader="BLOG"></BlogHeader>
    <main class="max-w-4xl mx-auto px-4 py-8">
        <div class="grid gap-4 md:grid-cols-4">
            {posts.map((post) => (
                <div class="bg-slate-200 px-2 py-4 rounded-lg shadow border border-slate-300">
                    <p class="text-sm text-slate-400">{post.data.pubDate}</p>
                    <a href={`/blog/${post.id.split('/').pop()}`} class="text-indigo-800 hover:underline text-2xl font-semibold">
                        {post.data.title || post.id}
                    </a>
                    <p class="italic font-mono text-slate-500">{post.data.description}</p>
                </div>
            ))}
        </div>
    </main>
</Layout>